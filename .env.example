# Chave da API Groq (obrigatória)
GROQ_API_KEY=your-groq-api-key-here

# Modelo Groq (opcional, default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Webhook para notificações de agendamento (exemplo funcional: webhook.site)
# Crie um bin em https://webhook.site/#!/create e cole a URL aqui
WEBHOOK_URL=https://webhook.site/#!/view/your-unique-id-here

# Caminho do banco SQLite (opcional, default: data/nr1.db)
# SQLITE_DB_PATH=data/nr1.db

# URL do servidor MCP (opcional, default: http://localhost:8001)
# MCP_INSPECTION_URL=http://localhost:8001

# Usar servidor MCP real em vez do fallback em memória (opcional, default: false)
# USE_MCP_SERVER=false
